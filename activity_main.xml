<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/board_bg"
    android:padding="12dp">

    <!-- Top bar: title + Record / Save / Share -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <HorizontalScrollView
        android:id="@+id/topActionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/appTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1">

        <LinearLayout
            android:id="@+id/topActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRecord"
                style="@style/TopPillButton"
                android:background="@drawable/bg_pill_record"
                android:textColor="@color/record_red"
                android:drawableStart="@drawable/ic_record_dot"
                android:drawablePadding="6dp"
                android:text="Record" />

            <ImageView
                android:id="@+id/btnStopRecording"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:padding="2dp"
                android:src="@drawable/ic_heptagon_stop"
                android:contentDescription="Stop recording"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnMore"
                style="@style/TopPillButton"
                android:drawableStart="@drawable/ic_more"
                android:drawablePadding="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="" />

            <TextView
                android:id="@+id/btnSave"
                style="@style/TopPillButton"
                android:drawableStart="@drawable/ic_save"
                android:drawablePadding="6dp"
                android:text="Save" />

            <TextView
                android:id="@+id/btnShare"
                style="@style/TopPillButton"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="6dp"
                android:text="Share" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Recording indicator, hidden unless recording -->
    <LinearLayout
        android:id="@+id/recordingBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_record"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topActionsScroll"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/recordingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="00:00"
            android:textColor="@color/record_red"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Left panel: colors + brush size -->
    <ScrollView
        android:id="@+id/leftPanel"
        android:layout_width="150dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_panel"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/topActionsScroll"
        app:layout_constraintBottom_toTopOf="@id/toolStrip"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/colorsPanelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:text="Colors"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/colorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <TextView
                    android:text="My Colors"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/customColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <TextView
                    android:text="Brush Size"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/brushSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView android:id="@+id/sizeSmall" style="@style/SizePreset" android:text="S" />
                    <TextView android:id="@+id/sizeMedium" style="@style/SizePreset" android:text="M" />
                    <TextView android:id="@+id/sizeLarge" style="@style/SizePreset" android:text="L" />
                    <TextView android:id="@+id/sizeXL" style="@style/SizePreset" android:text="XL" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/textOptionsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:text="Text Options"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:text="Font"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Spinner
                    android:id="@+id/fontSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:text="Text Size"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/textSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="30" />

                <TextView
                    android:text="Text Color"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/textColorGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:useDefaultMargins="false" />

                <TextView
                    android:id="@+id/textToolHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tap anywhere on the canvas to place your text."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnExitTextMode"
                    style="@style/SizePreset"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:text="Done" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Drawing canvas -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_panel"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/topActionsScroll"
        app:layout_constraintBottom_toTopOf="@id/toolStrip"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <com.mom.privatedrawing.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/canvas_bg" />
    </FrameLayout>

    <!-- Bottom tool strip -->
    <HorizontalScrollView
        android:id="@+id/toolStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_panel"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/toolStripInner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
